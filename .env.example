# Copy to .env and fill in. Never commit .env.

# Claude API
ANTHROPIC_API_KEY=

# LLM layer limits (per run)
LLM_MODEL=claude-haiku-5-5
LLM_MAX_TOKENS_PER_REQUEST=8000
LLM_MAX_SPEND_PER_RUN_USD=0.05
LLM_MAX_ITERATIONS=10

# Langfuse (leave keys empty to disable tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Postgres (docker-compose)
POSTGRES_USER=ops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ops
POSTGRES_PORT=5433
