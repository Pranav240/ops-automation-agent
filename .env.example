# Copy to .env and fill in. Never commit .env.

# Claude API
ANTHROPIC_API_KEY=

# LLM layer limits (per run)
# On Bedrock set LLM_PROVIDER=bedrock and LLM_MODEL=anthropic.claude-haiku-5-5
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_MAX_TOKENS_PER_REQUEST=8000
LLM_MAX_SPEND_PER_RUN_USD=0.05
LLM_MAX_ITERATIONS=10

# Langfuse (leave keys empty to disable tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Postgres (docker-compose)
POSTGRES_USER=ops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ops
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# Qdrant (retrieval ablation only, docker-compose)
QDRANT_URL=http://localhost:6333

# Mock internal API (uvicorn mock_api.app:app)
MOCK_API_URL=http://127.0.0.1:8000

# Text-to-SQL read-only role (python -m agent.run_history setup creates it with this password)
SQL_READER_PASSWORD=change-me-too

# Jira Service Management (free site): API token from id.atlassian.com > Security > API tokens
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# AWS intake (terraform -chdir=infra/aws output)
OPS_API_URL=
OPS_WORK_QUEUE_URL=
OPS_RUNS_TABLE=
